{:paths ["src"]

 ;; data.json is the only runtime dependency. See docs/decisions/0004-quint-cli.md.
 :deps {org.clojure/clojure   {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; clojure -M:test
  :test {:extra-paths ["test" "dev"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}

  ;; Trace generation / caching CLI (milestone M7).
  :gen {:main-opts ["-m" "uno.michelada.quint-connect.cli"]}}}
