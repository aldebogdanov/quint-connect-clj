{:tasks
 {test     {:doc  "Run tests that need no Quint installed"
            :task (shell "clojure -M:test -e :integration -e :slow")}

  test:all {:doc  "Run every test that shells out to quint, minus the slow ones"
            :task (shell "clojure -M:test -e :slow")}

  test:verify {:doc  "Only the verify tests: these run Apalache and take minutes"
               :task (shell "clojure -M:test -i :slow")}

  jar      {:doc  "Build the library jar into target/"
            :task (shell "clojure -T:build jar")}

  install  {:doc  "Install the jar into the local ~/.m2"
            :task (shell "clojure -T:build install")}

  deploy   {:doc  "Publish to Clojars; needs CLOJARS_USERNAME and a deploy token in CLOJARS_PASSWORD"
            :task (shell "clojure -T:build deploy")}

  fixtures {:doc  "Regenerate the ITF fixtures that have a fixed seed"
            :task (do
                    (shell {:dir "dev/fixtures"}
                           "quint run bank.qnt --main=bankTest --mbt --seed=42 --max-steps=4 --n-traces=2 --max-samples=2 --out-itf=bank_run_{seq}.itf.json --verbosity=0")
                    (shell {:dir "dev/fixtures"}
                           "quint run tracked.qnt --main=trackedTest --mbt --seed=42 --max-steps=4 --n-traces=1 --max-samples=1 --out-itf=tracked_run_{seq}.itf.json --verbosity=0")
                    (shell {:dir "dev/fixtures"}
                           "quint test tracked.qnt --main=trackedRuns --match=depositThenOverdraftTest --out-itf=tracked_test_{test}.itf.json --verbosity=0"))}}}
