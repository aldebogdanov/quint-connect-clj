{:tasks
 {test     {:doc  "Run tests that need no Quint installed"
            :task (shell "clojure -M:test -e :integration")}

  test:all {:doc  "Run every test, including those that shell out to quint"
            :task (shell "clojure -M:test")}

  fixtures {:doc  "Regenerate the ITF fixtures that have a fixed seed"
            :task (do
                    (shell {:dir "dev/fixtures"}
                           "quint run bank.qnt --main=bankTest --mbt --seed=42 --max-steps=4 --n-traces=2 --max-samples=2 --out-itf=bank_run_{seq}.itf.json --verbosity=0")
                    (shell {:dir "dev/fixtures"}
                           "quint run tracked.qnt --main=trackedTest --mbt --seed=42 --max-steps=4 --n-traces=1 --max-samples=1 --out-itf=tracked_run_{seq}.itf.json --verbosity=0")
                    (shell {:dir "dev/fixtures"}
                           "quint test tracked.qnt --main=trackedRuns --match=depositThenOverdraftTest --out-itf=tracked_test_{test}.itf.json --verbosity=0"))}}}
